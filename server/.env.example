# --- Netzwerk ---
# Muss zum Nginx-Proxy passen (deploy/nginx-video-cutter-api.conf -> :9015).
PORT=9015
HOST=127.0.0.1

# --- Grenzen ---
# Sollte zum Nginx client_max_body_size passen (dort 8g).
MAX_FILE_SIZE_MB=8192
MAX_DURATION_SEC=14400
FFMPEG_TIMEOUT_SEC=1200
MAX_CONCURRENT=2
JOB_TTL_SEC=1800
RATE_LIMIT_MAX=60

# --- FFmpeg ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Max. Anzahl angehängter Videos (Zusammenfügen) pro Job
MAX_APPEND_FILES=5

# --- Video-Bibliothek ---
# Gespeicherte Videos werden nach so vielen Sekunden ohne Benutzung gelöscht.
MEDIA_TTL_SEC=7200
# Obergrenze für alle gespeicherten Videos zusammen (MB).
MAX_MEDIA_TOTAL_MB=20480

# --- Projekte (gespeicherte Bearbeitungen) ---
# Standard: ~/.video-cutter/projects (NICHT im Backend-Ordner, den deploy.sh spiegelt).
# Am besten auf derselben Partition wie TMP_DIR (Hardlinks statt Kopien).
# PROJECTS_DIR=/var/lib/video-cutter/projects
# Obergrenze für alle Projekte zusammen (MB).
MAX_PROJECTS_TOTAL_MB=102400

# --- Temp ---
# Standard: <os-tmp>/video-cutter
# TMP_DIR=/var/tmp/video-cutter

# --- CORS ---
ALLOWED_ORIGINS=https://kodinitools.com,https://www.kodinitools.com

# --- KI: Untertitel & Schnittvorschläge (optional) ---
# whisper.cpp (lokale Spracherkennung). Ohne WHISPER_MODEL ist die KI-Karte gesperrt.
# WHISPER_CLI=/opt/whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL=/opt/whisper.cpp/models/ggml-large-v3-turbo-q5_0.bin
# WHISPER_THREADS=6
# WHISPER_TIMEOUT_SEC=3600
# Claude (nur hier eintragen, nie im Frontend!)
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
