# --- Netzwerk ---
# Muss zum Nginx-Proxy passen (deploy/nginx-video-cutter-api.conf -> :9015).
PORT=9015
HOST=127.0.0.1

# --- Grenzen ---
MAX_FILE_SIZE_MB=2048
MAX_DURATION_SEC=14400
FFMPEG_TIMEOUT_SEC=1200
MAX_CONCURRENT=2
JOB_TTL_SEC=1800
RATE_LIMIT_MAX=60

# --- FFmpeg ---
FFMPEG_PATH=ffmpeg

# --- Temp ---
# Standard: <os-tmp>/video-cutter
# TMP_DIR=/var/tmp/video-cutter

# --- CORS ---
ALLOWED_ORIGINS=https://kodinitools.com,https://www.kodinitools.com
